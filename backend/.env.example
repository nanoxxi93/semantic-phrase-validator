DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/semantic_phrases

# Inferencia de Embeddings: "huggingface" o "cloudflare"
EMBEDDING_PROVIDER=cloudflare

# Credenciales para Hugging Face (requerido si EMBEDDING_PROVIDER=huggingface)
HF_TOKEN=hf_dummy_token_for_dev
HF_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Credenciales para Cloudflare Workers AI (requerido si EMBEDDING_PROVIDER=cloudflare)
CLOUDFLARE_ACCOUNT_ID=tu_cloudflare_account_id_aqui
CLOUDFLARE_API_TOKEN=tu_cloudflare_api_token_aqui
CLOUDFLARE_MODEL=@cf/baai/bge-m3
CLOUDFLARE_GATEWAY_ID=semantic-phrase-validator

PORT=3000
NODE_ENV=development
SIMILARITY_THRESHOLD=0.80
TRUST_PROXY=1
EMBEDDING_CACHE_TTL_SECONDS=3600
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_INFERENCE_MAX=30
RATE_LIMIT_READ_MAX=100
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
